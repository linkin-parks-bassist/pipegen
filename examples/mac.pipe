// The parameterized toy MAC from the top-level README.
// Arithmetic is intentionally unsigned and truncates to W bits.
pipeline mac #(
    parameter integer W = 16
) begin

    stage M {m, x, b} yields {mx, b} begin

        logic [W-1:0] m;
        logic [W-1:0] x;
        logic [W-1:0] b;

        logic [2*W-1:0] mx = m * x;

    endstage

    stage AC {mx, b} yields {result} begin

        logic [2*W-1:0] mx_plus_b = mx + b;
        logic [W-1:0] result = mx_plus_b[W-1:0];

    endstage

endpipeline
